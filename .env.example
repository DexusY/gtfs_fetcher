# Database — asyncpg driver required.
# POSTGRES_PASSWORD is used by docker-compose and must match DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://admin:change-me@localhost:5432/gtfs_app

# JWT signing secret — the backend refuses to start with an empty or
# placeholder value. Generate one:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=

# Optional
# CORS_ORIGINS=http://localhost:3000
# METRICS_TOKEN=            # unset → /metrics returns 404
# GTFS_STATIC_TTL_HOURS=24
# JWT_TTL_HOURS=24
